{
    "target_device": "/dev/nvme0",
    "target_device_windows": "/dev/sdc",
    "target_device_linux": "/dev/nvme0",
    "device_type": "nvme",
    "device_label": "Internal NVMe (nvme0)",
    "refresh_rate_sec": 1,
    "opacity": 0.6,
    "position": "top-right",
    "offset_x": 25,
    "offset_y": 25,
    "sensor2_good_threshold_c": 60,
    "sensor2_high_threshold_c": 75,
    "sensor2_critical_threshold_c": 85,
    "enable_notifications": true,
    "run_at_startup": false,
    "smartctl_path": "/usr/sbin/smartctl",
    "good_threshold_c": 55,
    "high_threshold_c": 70,
    "critical_threshold_c": 80
}